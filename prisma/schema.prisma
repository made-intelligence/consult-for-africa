// ─── Meetings & Video Calls ─────────────────────────────────────────────────

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MeetingType {
  DISCOVERY_CALL
  PROJECT_CHECKIN
  INTERNAL
  CLIENT_REVIEW
  COACHING
}

model Meeting {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  type        MeetingType
  status      MeetingStatus @default(SCHEDULED)

  // Schedule
  scheduledAt    DateTime
  scheduledEndAt DateTime
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int? // actual duration in minutes

  // Google Meet
  meetLink        String? // Google Meet URL
  calendarEventId String? // Google Calendar event ID for sync

  // Participants
  organizerId  String?
  organizer    User?                @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]

  // Links to other entities
  engagementId  String?
  engagement    Engagement?    @relation(fields: [engagementId], references: [id])
  discoveryCall DiscoveryCall?
  clientId      String?

