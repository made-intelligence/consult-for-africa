  frameworkId  String
  framework    FrameworkTemplate @relation(fields: [frameworkId], references: [id])
  content      Json // AI-generated or consultant-filled content keyed by dimension
  aiGenerated  Boolean           @default(false)
  status       FrameworkStatus   @default(DRAFT)
  notes        String?           @db.Text
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([engagementId, frameworkId], map: "ProjectFramework_projectId_frameworkId_key")
  @@index([engagementId], map: "ProjectFramework_projectId_idx")
  @@map("ProjectFramework")
}

// ─── Training & Certification Academy ─────────────────────────────────────────

enum TrainingLevel {
  FOUNDATION
  SPECIALIST
  MASTER
}

enum TrainingModuleStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CertificationStatus {
  NOT_STARTED
  IN_PROGRESS
  EXAM_SCHEDULED
  CERTIFIED
  EXPIRED
  REVOKED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  CASE_STUDY
  SHORT_ANSWER
}

model TrainingTrack {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String        @db.Text
  level          TrainingLevel
  category       String // "methodology", "health_economics", "public_health", "tech", "leadership"
  iconName       String? // lucide icon name
  colorHex       String? // badge color
  prerequisites  String[] // slugs of prerequisite tracks
  estimatedHours Int           @default(20)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)

  // Pricing
  pricingType TrackPricingType @default(FREE)
  priceNGN    Decimal?         @db.Decimal(10, 2)
  discountPct Decimal?         @db.Decimal(5, 2) // e.g. 10.00 = 10% off for academy learners

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules     TrainingModule[]
  enrollments TrainingEnrollment[]
  purchases   TrackPurchase[]

  @@index([category, level])
  @@index([isActive])
}

model TrainingModule {
  id               String        @id @default(cuid())
  trackId          String
  track            TrainingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name             String
  slug             String        @unique
  description      String        @db.Text
  order            Int
  estimatedMinutes Int           @default(60)
  content          Json // structured content: sections, text, examples, exercises
  videoUrl         String?
  resources        Json? // { links: [], files: [], tools: [] }
  passingScore     Int           @default(70) // percentage
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  progress  ModuleProgress[]
  questions TrainingQuestion[]

  @@index([trackId, order])
}

model TrainingQuestion {
  id            String         @id @default(cuid())
  moduleId      String
  module        TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type          QuestionType   @default(MULTIPLE_CHOICE)
  question      String         @db.Text
  options       Json? // for multiple choice: [{ id, text, isCorrect }]
  correctAnswer String?        @db.Text // for short answer
  explanation   String?        @db.Text // shown after answering
  points        Int            @default(1)
  order         Int            @default(0)
  caseStudy     Json? // { scenario, data, exhibits } for case study questions
  createdAt     DateTime       @default(now())

  answers QuestionAnswer[]

  @@index([moduleId, order])
}

model TrainingEnrollment {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId        String
  track          TrainingTrack       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  status         CertificationStatus @default(NOT_STARTED)
  enrolledAt     DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  certifiedAt    DateTime?
  expiresAt      DateTime? // certifications expire after 2 years
  overallScore   Int? // final assessment score
  certificateUrl String? // generated PDF certificate

  moduleProgress ModuleProgress[]

  @@unique([userId, trackId])
  @@index([userId, status])
  @@index([trackId])
}

model ModuleProgress {
  id               String               @id @default(cuid())
  enrollmentId     String
  enrollment       TrainingEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId         String
  module           TrainingModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status           TrainingModuleStatus @default(LOCKED)
  startedAt        DateTime?
  completedAt      DateTime?
  score            Int? // quiz score percentage
  attempts         Int                  @default(0)
  timeSpentMinutes Int                  @default(0)
  lastAccessedAt   DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  answers QuestionAnswer[]

  @@unique([enrollmentId, moduleId])
  @@index([moduleId])
}

model QuestionAnswer {
  id           String           @id @default(cuid())
  progressId   String
  progress     ModuleProgress   @relation(fields: [progressId], references: [id], onDelete: Cascade)
  questionId   String
  question     TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String           @db.Text
  isCorrect    Boolean
  pointsEarned Int              @default(0)
  answeredAt   DateTime         @default(now())

  @@index([progressId])
  @@index([questionId])
}

// ─── Track Purchases (Paystack-gated enrollment) ────────────────────────────

model TrackPurchase {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId         String
  track           TrainingTrack @relation(fields: [trackId], references: [id])
  amountNGN       Decimal       @db.Decimal(10, 2)
  discountApplied Decimal?      @db.Decimal(5, 2)
  paystackRef     String        @unique
  paystackTxnId   String?
  status          String        @default("PENDING") // PENDING, CONFIRMED, FAILED, REFUNDED
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, trackId])
  @@index([paystackRef])
  @@index([userId])
}

// ─── Audit Trail ──────────────────────────────────────────────────────────────

model AuditLog {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       AuditAction
  entityType   String // "Project", "Deliverable", "Risk", "Phase", "Client", etc.
  entityId     String
  entityName   String? // Human-readable name for quick display
  engagementId String?     @map("projectId") // Link to engagement if applicable
  details      Json? // { before: {...}, after: {...}, note: "..." }
  ipAddress    String?
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([engagementId], map: "AuditLog_projectId_createdAt_idx")
  @@index([action, createdAt])
}

// ─── Staffing & Opportunity Board ─────────────────────────────────────────────

model StaffingRequest {
  id           String           @id @default(cuid())
  engagementId String           @map("projectId")
  engagement   Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?            @relation("StaffingRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  trackId      String?
  track        EngagementTrack? @relation(fields: [trackId], references: [id])

  role                 String // "Lead Consultant", "Analyst", etc.
  description          String    @db.Text // what the work involves
  skillsRequired       String[] // e.g. ["turnaround", "revenue-cycle", "digital-health"]
  hoursPerWeek         Int // expected weekly commitment
  duration             String? // "8 weeks", "3 months", etc.
  rateType             RateType
  rateBudget           Decimal?  @db.Decimal(10, 2) // optional budget hint
  rateCurrency         Currency  @default(NGN)
  urgency              String    @default("normal") // "normal", "urgent", "critical"
  status               String    @default("OPEN") // OPEN, FILLED, CANCELLED
  filledAt             DateTime?
  filledByAssignmentId String?

  expressions StaffingExpression[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([engagementId], map: "StaffingRequest_projectId_idx")
}

model StaffingExpression {
  id                String          @id @default(cuid())
  staffingRequestId String
  staffingRequest   StaffingRequest @relation(fields: [staffingRequestId], references: [id], onDelete: Cascade)
  consultantId      String
  consultant        User            @relation("StaffingExpressions", fields: [consultantId], references: [id], onDelete: Cascade)

  note       String? @db.Text // "I have deep turnaround experience..."
  status     String  @default("INTERESTED") // INTERESTED, SHORTLISTED, SELECTED, PASSED
  matchScore Int? // Nuru AI match score (0-100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffingRequestId, consultantId])
  @@index([consultantId])
}

enum ProposalStatus {
  DRAFT
  REVIEW
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Proposal {
  id          String  @id @default(cuid())
  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id])
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  title         String
  clientName    String
  clientContact String?
  serviceType   ServiceType?
  budgetRange   String?
  timeline      String?
  challenges    String[]
  objectives    String[]
  content       String         @db.Text
  status        ProposalStatus @default(DRAFT)
  sentAt        DateTime?
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  SUBMIT
  APPROVE
  REJECT
  ENROLL
  ASSIGN
  UPLOAD
  DOWNLOAD
  LOGIN
  AI_GENERATE
  /// A project record has fallen behind the work and its manager was chased.
  FRESHNESS_NUDGE
  /// The chase went unanswered long enough to reach the partner.
  FRESHNESS_ESCALATION
}

// ─── Maarova Assessment Platform ──────────────────────────────────────────────

enum MaarovaStream {
  RECRUITMENT
  DEVELOPMENT
  INTELLIGENCE
}

enum MaarovaAssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum MaarovaModuleType {
  DISC
  VALUES_DRIVERS
  EMOTIONAL_INTEL
  CILTI
  PLTI // Professional-to-Leadership Identity: the non-clinical twin of CILTI
  THREE_SIXTY
  CULTURE_TEAM
}

/// Which track an item or module is written for. Most items are role neutral
/// and stay BOTH. A clinical item and its non-clinical twin carry the same
/// dimension mapping and differ only in the scenario, so they score alike.
enum MaarovaAudience {
  BOTH
  CLINICAL
  NON_CLINICAL
}

/// How someone came into leadership. This is the question the identity module
/// actually measures, and it decides which form of the assessment is served.
enum MaarovaTrack {
  CLINICAL
  NON_CLINICAL
}

enum MaarovaReportStatus {
  GENERATING
  READY
  DELIVERED
  ARCHIVED
  FAILED
}

enum MaarovaCoachingStatus {
  PENDING_MATCH
  MATCHED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MaarovaDevelopmentGoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DEFERRED
}

enum MaarovaUserRole {
  USER
  MANAGER
  HR_ADMIN
}

enum MaarovaRaterRole {
  SELF
  SUPERVISOR
  PEER
  DIRECT_REPORT
}

enum MaarovaQuestionFormat {
  FORCED_CHOICE_PAIR
  RANKING
  SCENARIO_RESPONSE
  LIKERT_5
  LIKERT_7
  FREQUENCY_SCALE
  FREE_TEXT
}

model MaarovaOrganisation {
  id              String        @id @default(cuid())
  name            String
  type            String
  country         String        @default("Nigeria")
  city            String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  stream          MaarovaStream
  // maxAssessments = "leader coverage" credits the org has paid for.
  // usedAssessments = count of distinct users in this org with at least one
  // COMPLETED assessment, EXCLUDING the org admin (whose email matches
  // contactEmail). Retakes by the same user are free. Abandoned or expired
  // sessions consume nothing.
  maxAssessments  Int           @default(20)
  usedAssessments Int           @default(0)
  isActive        Boolean       @default(true)
  notes           String?       @db.Text

  // Self-serve staff join link. One shareable URL per org so a client can put
  // the assessment in front of a whole team without us creating each user by
  // hand. Registration through the link is capped by maxAssessments.
  joinToken     String?   @unique
  joinEnabled   Boolean   @default(false)
  joinExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    MaarovaUser[]
  coaches  MaarovaCoach[]
  invoices MaarovaCoachingInvoice[]

  @@index([stream, isActive])
}

model MaarovaUser {
  id                 String              @id @default(cuid())
  organisationId     String
  organisation       MaarovaOrganisation @relation(fields: [organisationId], references: [id])
  email              String              @unique
  name               String
  passwordHash       String?
  role               MaarovaUserRole     @default(USER)
  title              String?
  department         String?
  yearsInRole        Int?
  yearsInHealthcare  Int?
  clinicalBackground String?
  /// Null until asked. clinicalBackground cannot serve here: it is free text
  /// naming a discipline and is null for most users, where null means
  /// unanswered rather than non-clinical.
  track              MaarovaTrack?
  managerId          String?
  manager            MaarovaUser?        @relation("ManagerReports", fields: [managerId], references: [id])
  directReports      MaarovaUser[]       @relation("ManagerReports")
  isPortalEnabled    Boolean             @default(false)
  lastLoginAt        DateTime?
  invitedAt          DateTime?
  inviteEmailStatus  String? // SENT | FAILED (null = not yet attempted)
  inviteEmailSentAt  DateTime?
  inviteEmailError   String?             @db.Text
  resetToken         String?
  resetTokenExpiry   DateTime?
  outreachCampaignId String? // which outreach campaign brought this user in (null = org invite)
  outreachTargetId   String? // links back to the specific OutreachTarget
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  sessions           MaarovaAssessmentSession[]
  reports            MaarovaReport[]
  coachingMatches    MaarovaCoachingMatch[]
  developmentGoals   MaarovaDevelopmentGoal[]
  raterInvites       Maarova360RaterInvite[]
  threeSixtyRequests Maarova360Request[]

  // Communications CRM back-relations
  communications Communication[]

  @@index([organisationId])
  @@index([managerId])
}

enum MaarovaCoachVettingStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
}

model MaarovaCoach {
  id              String               @id @default(cuid())
  organisationId  String?
  organisation    MaarovaOrganisation? @relation(fields: [organisationId], references: [id])
  name            String
  email           String               @unique
  title           String
  bio             String               @db.Text
  specialisms     String[]
  certifications  String[]
  country         String
  city            String?
  yearsExperience Int
  maxClients      Int                  @default(8)
  activeClients   Int                  @default(0)
  isActive        Boolean              @default(true)
  avatarUrl       String?
  passwordHash    String?
  isPortalEnabled Boolean              @default(false)
  lastLoginAt     DateTime?

  // Smart matching fields
  languages            String[] @default(["English"])
  timezone             String   @default("Africa/Lagos")
  healthcareExperience Boolean  @default(false)
  developmentFocus     String[] // e.g. ["emotional_intelligence", "strategic_thinking", "team_leadership"]

  // Vetting workflow
  vettingStatus   MaarovaCoachVettingStatus @default(APPLIED)
  applicationDate DateTime?
  interviewDate   DateTime?
  interviewScore  Int? // 1-100
  interviewNotes  String?                   @db.Text
  vetNotes        String?                   @db.Text
  reviewedBy      String?

  // Financials
  hourlyRate Decimal? @db.Decimal(10, 2)
  currency   String   @default("NGN")

  // Performance
  avgSessionRating     Decimal? @db.Decimal(3, 2) // rolling average 1-5
  totalSessions        Int      @default(0)
  completedEngagements Int      @default(0)

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches  MaarovaCoachingMatch[]
  invoices MaarovaCoachingInvoice[]

  @@index([isActive])
  @@index([vettingStatus])
}

model MaarovaModule {
  id               String            @id @default(cuid())
  type             MaarovaModuleType
  audience         MaarovaAudience   @default(BOTH)
  name             String
  slug             String            @unique
  description      String            @db.Text
  order            Int
  estimatedMinutes Int               @default(10)
  isActive         Boolean           @default(true)
  scoringConfig    Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  questionGroups  MaarovaQuestionGroup[]
  moduleResponses MaarovaModuleResponse[]

  @@index([type])
  @@index([order])
}

model MaarovaQuestionGroup {
  id          String        @id @default(cuid())
  moduleId    String
  module      MaarovaModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String?
  description String?       @db.Text
  order       Int
  context     String?       @db.Text
  createdAt   DateTime      @default(now())

  questions MaarovaQuestion[]

  @@index([moduleId, order])
}

model MaarovaQuestion {
  id           String                @id @default(cuid())
  groupId      String
  group        MaarovaQuestionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  audience     MaarovaAudience       @default(BOTH)
  /// Links a twin to the item it parallels, so the pair can be compared when
  /// there is enough data to test whether the two forms really are equivalent.
  twinOfId     String?
  format       MaarovaQuestionFormat
  text         String                @db.Text
  options      Json
  dimension    String?
  subDimension String?
  isReversed   Boolean               @default(false)
  weight       Decimal               @default(1) @db.Decimal(4, 2)
  order        Int
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())

  responses MaarovaItemResponse[]

  @@index([groupId, order])
}

model MaarovaAssessmentSession {
  id               String                  @id @default(cuid())
  userId           String
  user             MaarovaUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           MaarovaAssessmentStatus @default(NOT_STARTED)
  sessionType      String                  @default("full")
  stream           MaarovaStream
  track            MaarovaTrack            @default(CLINICAL)
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  totalTimeMinutes Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  moduleResponses MaarovaModuleResponse[]
  report          MaarovaReport?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model MaarovaModuleResponse {
  id               String                   @id @default(cuid())
  sessionId        String
  session          MaarovaAssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId         String
  module           MaarovaModule            @relation(fields: [moduleId], references: [id])
  status           MaarovaAssessmentStatus  @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  timeSpentSeconds Int?
  rawScores        Json?
  scaledScores     Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  itemResponses MaarovaItemResponse[]

  @@unique([sessionId, moduleId])
  @@index([sessionId])
  @@index([moduleId])
}

model MaarovaItemResponse {
  id               String                @id @default(cuid())
  moduleResponseId String
  moduleResponse   MaarovaModuleResponse @relation(fields: [moduleResponseId], references: [id], onDelete: Cascade)
  questionId       String
  question         MaarovaQuestion       @relation(fields: [questionId], references: [id])
  answer           Json
  responseTimeMs   Int?
  answeredAt       DateTime              @default(now())

  @@unique([moduleResponseId, questionId])
  @@index([moduleResponseId])
}

model Maarova360Request {
  id                 String      @id @default(cuid())
  subjectId          String
  subject            MaarovaUser @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sessionId          String?
  status             String      @default("COLLECTING")
  minRaters          Int         @default(5)
  deadline           DateTime
  lastReminderSentAt DateTime? // last time we emailed the leader to invite raters (admin or auto)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  invites Maarova360RaterInvite[]

  @@index([subjectId])
}

model Maarova360RaterInvite {
  id          String            @id @default(cuid())
  requestId   String
  request     Maarova360Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  raterId     String?
  rater       MaarovaUser?      @relation(fields: [raterId], references: [id])
  raterEmail  String
  raterName   String
  role        MaarovaRaterRole
  token       String            @unique
  status      String            @default("INVITED")
  completedAt DateTime?
  responses   Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([requestId])
  @@index([token])
}

model MaarovaReport {
  id        String                   @id @default(cuid())
  sessionId String                   @unique
  session   MaarovaAssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      MaarovaUser              @relation(fields: [userId], references: [id])
  status    MaarovaReportStatus      @default(GENERATING)

  overallScore         Int?
  dimensionScores      Json?
  radarChartData       Json?
  benchmarkComparisons Json?

  executiveSummary    String? @db.Text
  strengthsAnalysis   String? @db.Text
  developmentAreas    String? @db.Text
  nextLeadershipEdge  String? @db.Text
  blindSpotAnalysis   String? @db.Text
  coachingPriorities  Json?
  leadershipArchetype String?
  archetypeNarrative  String? @db.Text
  signatureStrengths  Json?

  fullReportContent Json?

  generatedAt DateTime?
  deliveredAt DateTime?
  pdfUrl      String?

  shareToken     String?   @unique
  shareEnabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model MaarovaCoachingMatch {
  id                String                @id @default(cuid())
  userId            String
  user              MaarovaUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId           String
  coach             MaarovaCoach          @relation(fields: [coachId], references: [id])
  status            MaarovaCoachingStatus @default(PENDING_MATCH)
  matchScore        Int?
  matchRationale    String?               @db.Text
  programme         String                @default("standard_6_month")
  startDate         DateTime?
  endDate           DateTime?
  sessionsCompleted Int                   @default(0)
  sessionsScheduled Int                   @default(0)
  lastSessionAt     DateTime?
  nextSessionAt     DateTime?
  notes             String?               @db.Text

  // Chemistry call flow
  chemistryCallScheduledAt DateTime?
  chemistryCallLink        String?
  chemistryCallCompletedAt DateTime?
  chemistryCallNotes       String?   @db.Text
  chemistryCallRating      Int? // 1-5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions MaarovaCoachingSession[]
  invoices MaarovaCoachingInvoice[]

  @@index([userId])
  @@index([coachId, status])
}

model MaarovaCoachingSession {
  id          String               @id @default(cuid())
  matchId     String
  match       MaarovaCoachingMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  completedAt DateTime?
  duration    Int?
  notes       String?              @db.Text
  focusAreas  String[]
  meetingLink String?
  actionItems String[]
  status      String               @default("SCHEDULED")

  // Session template
  sessionNumber   Int? // 1-24, auto-set
  sessionTemplate String? // "goal_setting" | "working" | "progress_review" | "integration"

  // Structured notes (template-based)
  agenda          Json? // { items: string[] }
  keyInsights     String? @db.Text
  commitments     Json? // { items: { text: string, dueDate?: string }[] }
  coachReflection String? @db.Text

  // Post-session feedback
  coacheeRating   Int? // 1-5
  coacheeFeedback String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId, scheduledAt])
}

model MaarovaCoachingInvoice {
  id             String                @id @default(cuid())
  invoiceNumber  String                @unique
  matchId        String?
  match          MaarovaCoachingMatch? @relation(fields: [matchId], references: [id])
  coachId        String
