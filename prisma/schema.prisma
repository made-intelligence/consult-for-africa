  CADREHEALTH
  MAAROVA
}

enum CampaignPostStatus {
  IDEA
  DRAFTING
  READY_FOR_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
}

enum SocialPlatform {
  LINKEDIN
  TWITTER
  INSTAGRAM
  TIKTOK
  FACEBOOK
  WHATSAPP
  EMAIL
}

model Campaign {
