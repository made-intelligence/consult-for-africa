  updatedAt DateTime @updatedAt

  @@unique([opportunityId, agentId])
  @@index([agentId])
  @@index([opportunityId])
}

model AgentDeal {
  id            String           @id @default(cuid())
  dealCode      String           @unique
  opportunityId String
  opportunity   AgentOpportunity @relation(fields: [opportunityId], references: [id])
  agentId       String
  agent         SalesAgent       @relation(fields: [agentId], references: [id])

  prospectName  String
  prospectOrg   String?
  prospectEmail String?
  prospectPhone String?
  prospectTitle String?

  stage        AgentDealStage @default(PROSPECT)
  stageHistory Json?

  dealValue       Decimal? @db.Decimal(14, 2)
  dealCurrency    Currency @default(NGN)
  dealDescription String?  @db.Text

  closedAt    DateTime?
  closedValue Decimal?  @db.Decimal(14, 2)
  proofDocUrl String?

  verifiedById      String?
  verifiedAt        DateTime?
  verificationNotes String?   @db.Text

  nextFollowUpAt DateTime?
  notes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions AgentCommission[]

  @@index([agentId])
  @@index([opportunityId])
  @@index([stage])
}

model AgentCommission {
  id      String     @id @default(cuid())
  dealId  String
  deal    AgentDeal  @relation(fields: [dealId], references: [id])
  agentId String
  agent   SalesAgent @relation(fields: [agentId], references: [id])

  commissionType CommissionType
  baseValue      Decimal        @db.Decimal(14, 2)
  rate           Decimal        @db.Decimal(10, 2)
  amount         Decimal        @db.Decimal(14, 2)
  currency       Currency       @default(NGN)

  period       String?
  periodNumber Int?

  status       CommissionStatus @default(PENDING)
  verifiedAt   DateTime?
  approvedAt   DateTime?
  approvedById String?
  paidAt       DateTime?

  payoutId String?
  payout   AgentPayout? @relation(fields: [payoutId], references: [id])

  disputeReason String? @db.Text
  notes         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([dealId])
  @@index([status])
  @@index([payoutId])
}

model AgentPayout {
  id         String     @id @default(cuid())
  payoutCode String     @unique
  agentId    String
  agent      SalesAgent @relation(fields: [agentId], references: [id])

  totalAmount Decimal  @db.Decimal(14, 2)
  currency    Currency @default(NGN)
  status      String   @default("PENDING")

  paymentMethod String?
  paymentRef    String?
  bankName      String?
  accountNumber String?
  accountName   String?

  processedById String?
  processedAt   DateTime?
  confirmedAt   DateTime?
  failureReason String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions AgentCommission[]

  @@index([agentId])
  @@index([status])
}

// ─── FOUNDER IDEATION ────────────────────────────────────────────────────────

