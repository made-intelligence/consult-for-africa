  leftAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([meetingId, email])
  @@index([meetingId])
  @@index([userId])
}

// ─── NDA & Legal Documents ───────────────────────────────────────────────────

enum NdaType {
  MUTUAL_CLIENT // Standard Mutual NDA (your v1.0 template)
  CONSULTANT_MASTER // One-time NDA for consultants joining C4A
  PROJECT_SPECIFIC // Extra NDA for sensitive engagements (M&A, etc.)
}

enum NdaStatus {
  DRAFT // Generated, not yet sent
  PENDING_PARTY_A // Awaiting Party A signature
  PENDING_PARTY_B // Awaiting Party B (C4A countersign)
  ACTIVE // Fully executed
  EXPIRED // Past the 3-year confidentiality period
  TERMINATED // Manually terminated
}

model Nda {
  id      String    @id @default(cuid())
  type    NdaType
  status  NdaStatus @default(DRAFT)
  version String    @default("1.0")

  // Party A (Client / Consultant / External)
  partyAName      String
  partyAOrg       String
  partyATitle     String?
  partyAEmail     String
  partyASignature String? // base64 signature image
  partyASignedAt  DateTime?
  partyAIp        String? // IP address at time of signing

  // Party B (C4A side)
  partyBName      String    @default("Consult For Africa")
  partyBOrg       String    @default("Consult For Africa")
  partyBTitle     String?
  partyBEmail     String?
  partyBSignature String?
  partyBSignedAt  DateTime?
  partyBIp        String?

  // Schedule
  effectiveDate DateTime
  expiresAt     DateTime? // auto-calculated: engagement end + 3 years

  // Signed PDF
  signedPdfUrl String? // S3 URL of fully-executed PDF
  signedPdfKey String? // S3 key for deletion

  // Links
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id])
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id])
  consultantId String? // User ID of consultant (for CONSULTANT_MASTER)
  consultant   User?       @relation("ConsultantNdas", fields: [consultantId], references: [id], onDelete: SetNull)

  // Signing token (for email-based signing by external parties)
  signingToken    String?   @unique
  signingTokenExp DateTime?

  // Audit
  createdById String?
  createdBy   User?    @relation("NdaCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([engagementId])
  @@index([clientId])
  @@index([consultantId])
  @@index([status])
  @@index([signingToken])
}

// ─── Delegation Task Board ───────────────────────────────────────────────────

/// A unit of delegated work. Assignee based rather than role based, so the same
/// board carries Founding Partner to EA to Administrative Assistant and the hire
/// after that without rework. The assigner is the reviewer, which is what keeps
/// review flowing back up the same chain the work came down.
model Task {
  id    String @id @default(cuid())
  title String

  /// Why this matters and what it feeds into. Written at assignment, never verbally.
  brief            String @db.Text
  /// What finished looks like, in the assignee's words rather than the assigner's.
  definitionOfDone String @db.Text

  assigneeId String
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  /// Also the reviewer. Abigail blocking or submitting raises it to the EA, not to Debo.
  assignerId String
  assigner   User   @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: Cascade)

  /// The EA can break one of Debo's tasks into sub-tasks. The rollup shows on the
  /// parent so the original assigner sees progress without being in the detail.
  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")

  dueDate   DateTime?
  /// A deliberate mid-point, set at assignment and not negotiated later, so a five
  /// day task gets a day two conversation instead of a day five surprise.
  checkInAt DateTime?

  /// The assigner's estimate, visible to the assignee. If the actual comes in at
  /// triple, the estimate was wrong and both parties learn something.
  estimatedMinutes Int?
  actualMinutes    Int?

  status        TaskStatus @default(ASSIGNED)
  /// Set when status is BLOCKED. Lets someone stop without interrupting anyone and
  /// without it reading as failure.
  blockedReason String?    @db.Text
  /// Set when status is CHANGES_REQUESTED. Work comes back with a written note
  /// rather than being silently redone, so the correction is reusable.
  reviewNote    String?    @db.Text

  /// "Anything new to the assignee gets a worked example attached the first
  /// time." Without one, a definition of done describes a thing the assignee
  /// has never seen. The first inventory count came back in ten minutes against
  /// a three hour estimate with nothing recorded, which is what that costs.
  workedExample String? @db.Text

  /// Loose link so a task can hang off a lead, a meeting or a communication
  /// without a foreign key per entity type.
  linkedEntityType String?
  linkedEntityId   String?

  /// Set when this task was generated by the operating rhythm rather than by a
  /// person, so a missed cadence is visible as a gap rather than as silence.
  recurringTaskId String?
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  /// What the assignee says they are handing over, written at the moment of
  /// submitting. Sits next to the attachments rather than in a comment thread,
  /// because the reviewer should not have to read a conversation to find out
  /// what they are being asked to judge.
  handoverNote String? @db.Text

  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   TaskQuestion[]
  attachments TaskAttachment[]
  events      TaskEvent[]

  @@index([assigneeId, status])
  @@index([assignerId, status])
  @@index([status])
  @@index([dueDate])
  @@index([parentTaskId])
  @@index([linkedEntityType, linkedEntityId])
  @@index([recurringTaskId])
}

/// What the assignee is actually handing over.
///
/// Submitting used to record a timestamp and nothing else. The reviewer was
/// asked to sign off work they could not see, so "submitted" came to mean
/// "trust me" and signing off came to mean "I believe you". The first inventory
/// count came back in ten minutes against a three hour estimate and there was
/// nothing on the record to look at.
model TaskAttachment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// What it is called in the list: the filename, or what the link points at.
  label String

  /// Exactly one of these is set. A file the firm holds, or a pointer to where
  /// the work actually lives, because a shared folder is still an answer.
  fileKey String?
  url     String?

  contentType String?
  sizeBytes   Int?

  uploadedById String
  uploadedBy   User   @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
}

/// One row per move, carrying the one note that move required.
///
/// The status columns say where a task is now. They cannot say it was sent back
/// twice, who cleared the block, or what the reviewer said the first time. A
/// task that bounced three times and one that landed first time read
/// identically on the board, which threw away the only thing worth knowing
/// about how a working relationship is going.
model TaskEvent {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  kind TaskEventKind @default(STATUS)

  /// Null where there is no previous state to leave, and on a change of hands.
  fromStatus TaskStatus?
  toStatus   TaskStatus?

  /// The note the move required. Blocking says what is in the way, sending back
  /// says what to change, handing over says what is being handed over,
  /// cancelling says why, signing off says what was good. One note per move, so
  /// no column ever has to carry two meanings at once.
  note String? @db.Text

  actorId String
  actor   User   @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// ─── Office of the Founding Partner ──────────────────────────────────────────

/// A promise somebody made, and the record of chasing it.
///
/// Deliberately not a Task. A task is work the firm holds and can assign; a
/// commitment is usually owed by somebody we cannot assign to, which is exactly
/// why it gets forgotten. Meetings already capture action items and nothing has
/// ever turned them into anything, so this is where they land.
model Commitment {
  id   String @id @default(cuid())
  what String @db.Text

  /// Who owes it. A user when it is ours, a name and email when it is theirs.
  owedByUserId String?
  owedByUser   User?   @relation("CommitmentOwner", fields: [owedByUserId], references: [id], onDelete: SetNull)
  owedByName   String?
  owedByEmail  String?

  /// Who it is owed to. Usually the principal whose office is chasing it.
  owedToUserId String?
  owedToUser   User?   @relation("CommitmentCreditor", fields: [owedToUserId], references: [id], onDelete: SetNull)

  dueDate DateTime?
  status  CommitmentStatus @default(OPEN)

  /// Where the promise was made. MEETING, COMMUNICATION, CALL or MANUAL.
  sourceType String?
  sourceId   String?
  meetingId  String?
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  /// The chase record. A commitment nobody has chased and a commitment chased
  /// four times are different problems, and only one of them is the debtor's.
  lastChasedAt DateTime?
  chaseCount   Int       @default(0)
  nextChaseAt  DateTime?

  closedAt DateTime?
  note     String?   @db.Text

  recordedById String
  recordedBy   User   @relation("CommitmentRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
  @@index([owedByUserId, status])
  @@index([owedToUserId, status])
  @@index([nextChaseAt])
  @@index([meetingId])
}

/// Something waiting on one person, teed up so it can be cleared in one sitting.
///
/// The required fields are the point. An assistant who has to write the options,
/// a recommendation and the cost of delay has done the thinking before the
/// principal is interrupted, which is the difference between delegating a
/// decision and merely forwarding it.
model Decision {
  id         String @id @default(cuid())
  title      String
  background String @db.Text

  options        String[]
  recommendation String   @db.Text
  /// What happens if this is left alone. Makes the price of a deferral visible
  /// at the moment of deferring it.
  costOfDelay    String?  @db.Text

  dueBy  DateTime?
  status DecisionStatus @default(PENDING)

  outcome     String?   @db.Text
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("DecisionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  /// Whose decision it is, and who put it in front of them.
  forUserId  String
  forUser    User   @relation("DecisionPrincipal", fields: [forUserId], references: [id], onDelete: Cascade)
  raisedById String
  raisedBy   User   @relation("DecisionRaiser", fields: [raisedById], references: [id], onDelete: Cascade)

  linkedEntityType String?
  linkedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([forUserId, status])
  @@index([status, dueBy])
  @@index([raisedById])
}

/// The recurring cadence of the firm, as a template that generates tasks.
///
/// The point is that the rhythm outlives whoever holds the seat. An assistant
/// rebuilding the week from memory is a rhythm that leaves when they do.
model RecurringTask {
  id               String @id @default(cuid())
  title            String
  brief            String @db.Text
  definitionOfDone String @db.Text

  assigneeId String
  assignee   User   @relation("RecurringAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignerId String
  assigner   User   @relation("RecurringAssigner", fields: [assignerId], references: [id], onDelete: Cascade)

  cadence RecurrenceCadence

  /// 1 (Monday) to 7 (Sunday) for weekly and fortnightly cadences.
  dayOfWeek   Int?
  /// 1 to 28 for monthly and quarterly. Capped at 28 so every month has one.
  dayOfMonth  Int?
  /// 1 to 12 for annual, and the first month of the cycle for quarterly.
  monthOfYear Int?

  /// How many days before the occurrence the task should land on the desk. A
  /// board pack due on the 30th is useless raised on the 30th.
  leadTimeDays      Int  @default(0)
  /// Days after the task appears that the mid-point conversation is due.
  checkInOffsetDays Int?
  estimatedMinutes  Int?

  /// Where the work happens, copied onto every task this template generates.
  /// A recurring brief that names a section but cannot reach it sends the
  /// assignee hunting through the sidebar once a month, every month.
  linkedEntityType String?
  linkedEntityId   String?

  active           Boolean   @default(true)
  /// The occurrence date most recently generated, so a run is never duplicated
  /// and a gap is detectable.
  lastGeneratedFor DateTime?

  generatedTasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, cadence])
  @@index([assigneeId])
}

// ─── Office inventory and assets ─────────────────────────────────────────────

/// Something the firm owns and tracks one by one, because it matters who has it.
/// A laptop is an Asset. Printer paper is a StockItem.
model Asset {
  id           String        @id @default(cuid())
  /// The label physically stuck on the thing. Unique so a stock take can match
  /// what is on the shelf to what is on the register.
  tag          String        @unique
  name         String
  category     AssetCategory
  make         String?
  model        String?
  serialNumber String?

  purchaseDate      DateTime?
  purchasePrice     Decimal?  @db.Decimal(12, 2)
  currency          String?   @default("NGN")
  supplier          String?
  warrantyExpiresAt DateTime?

  condition AssetCondition @default(GOOD)
  status    AssetStatus    @default(IN_STOCK)
  location  String?

  /// The current holder, denormalised off the open AssetAssignment so the
  /// register can be read without walking the custody chain every time.
  assignedToUserId String?
  assignedToUser   User?     @relation("AssetHolder", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToName   String?
  assignedAt       DateTime?

  notes String? @db.Text

  assignments AssetAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, category])
  @@index([assignedToUserId])
  @@index([warrantyExpiresAt])
}

/// The chain of custody. Who had it, from when to when, and what state it was in
/// at each handover. This is the part that answers "it was already broken when
/// I got it", which is the argument asset registers exist to settle.
model AssetAssignment {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// The holder. A user when they are ours, a name when they are not.
  userId     String?
  user       User?   @relation("AssetHoldingUser", fields: [userId], references: [id], onDelete: SetNull)
  holderName String?

  issuedAt     DateTime        @default(now())
  returnedAt   DateTime?
  conditionOut AssetCondition
  conditionIn  AssetCondition?

  issuedById String
  issuedBy   User   @relation("AssetIssuer", fields: [issuedById], references: [id], onDelete: Cascade)

  note String? @db.Text

  @@index([assetId, returnedAt])
  @@index([userId])
}

/// Something counted rather than tracked individually: paper, toner, water,
/// stationery. The reorder level is the whole point, since the failure mode is
/// noticing on the morning it runs out.
model StockItem {
  id       String  @id @default(cuid())
  name     String
  category String?
  /// What one of them is: ream, box, pack, litre.
  unit     String  @default("unit")

  quantityOnHand Int @default(0)
  /// Order more when the count reaches this.
  reorderLevel   Int @default(0)

  location      String?
  supplier      String?
  unitCost      Decimal?  @db.Decimal(12, 2)
  currency      String?   @default("NGN")
  lastCountedAt DateTime?
  notes         String?   @db.Text

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quantityOnHand])
}

/// Every change to a count, and why. A quantity that moves without a movement
/// row is a number nobody can defend at a stock take.
model StockMovement {
  id     String    @id @default(cuid())
  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Signed: positive received, negative issued.
  delta        Int
  reason       StockMovementReason
  /// The count after this movement, so the history reconciles without replaying it.
  balanceAfter Int

  note      String?
  byUserId  String
  by        User     @relation("StockMover", fields: [byUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
}

/// A question asked against a task, without stopping work on it.
///
/// The two are exclusive on purpose. BLOCKED means "I have stopped and I need
/// you". A question means "still going, but I do not know what you meant".
/// There was no home for the second, so that traffic would have gone to
/// WhatsApp and left no record on the task it belongs to.
///
/// One question, one answer, deliberately not a thread. Anything needing more
/// turns than that is a conversation and should be had out loud.
model TaskQuestion {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  askedById String
  askedBy   User   @relation("TaskQuestionsAsked", fields: [askedById], references: [id], onDelete: Cascade)
  question  String @db.Text

  answer       String?   @db.Text
  answeredById String?
  answeredBy   User?     @relation("TaskQuestionsAnswered", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([answeredAt])
}

